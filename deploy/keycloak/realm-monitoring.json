{
  "realm": "monitoring",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "analista" },
      { "name": "auditor" },
      { "name": "administrador-inventario" }
    ]
  },
  "scopeMappings": [
    { "client": "monitoring-web", "roles": ["analista", "auditor", "administrador-inventario"] }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}},{\"name\":\"monitoring_scopes\",\"displayName\":\"Monitoring scopes\",\"multivalued\":true,\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]}}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "monitoring-web",
      "name": "Monitoring web console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://127.0.0.1:4200/auth/callback"],
      "webOrigins": ["http://127.0.0.1:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:4200/signed-out"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "monitoring_scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "monitoring_scopes",
            "claim.name": "monitoring_scopes",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "monitoring-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "monitoring-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin-inventario",
      "email": "admin-inventario@lab.invalid",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "monitoring_scopes": [
          "{\"site\":\"pipeline-site\",\"sensor\":\"pipeline-sensor\"}",
          "{\"site\":\"lab-site-b\",\"sensor\":\"lab-sensor-b\"}"
        ]
      },
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_LAB_PASSWORD}", "temporary": false }],
      "realmRoles": ["administrador-inventario"]
    },
    {
      "username": "analista",
      "email": "analista@lab.invalid",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "monitoring_scopes": ["{\"site\":\"pipeline-site\",\"sensor\":\"pipeline-sensor\"}"]
      },
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_LAB_PASSWORD}", "temporary": false }],
      "realmRoles": ["analista"]
    },
    {
      "username": "auditor",
      "email": "auditor@lab.invalid",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "monitoring_scopes": ["{\"site\":\"lab-site-b\",\"sensor\":\"lab-sensor-b\"}"]
      },
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_LAB_PASSWORD}", "temporary": false }],
      "realmRoles": ["auditor"]
    },
    {
      "username": "sin-ambito",
      "email": "sin-ambito@lab.invalid",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_LAB_PASSWORD}", "temporary": false }],
      "realmRoles": ["analista"]
    }
  ]
}
